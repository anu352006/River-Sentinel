# --- DATABASE CONFIG ---
# Your Firebase Realtime Database URL
FIREBASE_DATABASE_URL=https://your-firebase-project-default-rtdb.firebaseio.com/
FIREBASE_SECRET=

# --- AI API KEYS ---
# Groq API Key (for Llama 3.2 Vision and Llama 3.3 Chatbot) - https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# OpenAI API Key (optional fallback) - https://platform.openai.com/
OPENAI_API_KEY=your_openai_api_key_here

# OpenWeatherMap API Key (for real-time rainfall and temperature) - https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# --- SERVER CONFIG ---
PORT=5000
